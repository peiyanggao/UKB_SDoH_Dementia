library(CMAverse)
library(dplyr)

mydata   <- Analysis_Mediation_SDoH_Mediator_Dementia
Exposure <- "SDoH_score"
Mediator <- "PHQ9_score"
Outcome  <- "Dementia"

time_var  <- paste0(Outcome, "_years")
event_var <- paste0(Outcome, "_status")
covars    <- c("Age", "Sex", "Ethnic", "History_Diabetes",
               "History_Hypertension", "History_High.Cholesterol")

dat <- mydata %>%
  dplyr::select(all_of(c(Exposure, Mediator, time_var, event_var, covars))) %>%
  filter(complete.cases(.))

status <- as.character(dat[[event_var]])
stopifnot(all(status %in% c("0", "1")), any(status == "1"))
dat[[event_var]] <- as.integer(status)

dat[[Mediator]] <- as.numeric(as.character(dat[[Mediator]]))
stopifnot(all(is.finite(dat[[Mediator]])))


set.seed(9)
fit <- cmest(
  data = dat, model = "rb",
  outcome = time_var, event = event_var,
  exposure = Exposure, mediator = Mediator, basec = covars,
  astar = 0, a = 1,
  mreg = list("linear"),
  # mreg = list("logistic"),
  yreg = "coxph",
  EMint = FALSE, mval = list(0),
  estimation = "imputation", inference = "bootstrap",
  nboot = 1000, boot.ci.type = "per"
)
summary(fit)
