library(CMAverse)
library(dplyr)

mydata   <- Analysis_Mediation_SDoH_Mediator_Dementia
Exposure <- "SDoH_score"
Mediator <- "PHQ9_score"
Outcome  <- "Dementia"

time_var  <- paste0(Outcome, "_years")
event_var <- paste0(Outcome, "_status")
covars    <- c("Age", "Sex", "Ethnic", "History_Diabetes",
               "History_Hypertension", "History_High.Cholesterol")

dat <- mydata %>%
  dplyr::select(all_of(c(Exposure, Mediator, time_var, event_var, covars))) %>%
  filter(complete.cases(.))

status <- as.character(dat[[event_var]])
stopifnot(all(status %in% c("0", "1")), any(status == "1"))
dat[[event_var]] <- as.integer(status)

dat[[Mediator]] <- as.numeric(as.character(dat[[Mediator]]))
stopifnot(all(is.finite(dat[[Mediator]])))


set.seed(9)
fit <- cmest(
  data = dat, model = "rb",
  outcome = time_var, event = event_var,
  exposure = Exposure, mediator = Mediator, basec = covars,
  astar = 0, a = 1,
  mreg = list("linear"),
  # mreg = list("logistic"),
  yreg = "coxph",
  EMint = FALSE, mval = list(0),
  estimation = "imputation", inference = "bootstrap",
  nboot = 1000, boot.ci.type = "per"
)
summary(fit)

pe <- fit$effect.pe
lo <- fit$effect.ci.low
hi <- fit$effect.ci.high
pv <- fit$effect.pval

fmt_ci <- function(key) {
  sprintf("%.2f (%.2f-%.2f)", pe[key], lo[key], hi[key])
}
fmt_p <- function(p) {
  ifelse(is.na(p), NA_character_,
         ifelse(p < 0.001, "<0.001", sprintf("%.3f", p)))
}

RESULT <- data.frame(
  Exposure = Exposure,
  Outcome  = Outcome,
  N        = nrow(dat),
  n_med    = 1L,
  Mediators = Mediator,
  Prop     = sprintf("%.2f%%", 100 * pe["pm"]),
  Prop.CI  = sprintf("%.2f%% (%.2f%%-%.2f%%)",
                     100 * pe["pm"], 100 * lo["pm"], 100 * hi["pm"]),
  Prop.P   = fmt_p(pv["pm"]),
  TE.CI    = fmt_ci("Rte"),
  DE.CI    = fmt_ci("Rtnde"),
  IE.CI    = fmt_ci("Rtnie"),
  IE.P     = fmt_p(pv["Rtnie"]),
  Prop.raw = unname(pe["pm"]),
  TE.raw   = unname(pe["Rte"]),
  DE.raw   = unname(pe["Rtnde"]),
  IE.raw   = unname(pe["Rtnie"]),
  row.names = NULL
)

print(RESULT, row.names = FALSE)

